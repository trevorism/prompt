{
  "name": "app",
  "version": "0.1.0",
  "description": "Trevorism Prompt",
  "author": "trevorism <tbrooks@trevorism.com>",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "accept": "vitest run",
    "test:unit": "vitest",
    "test:e2e": "start-server-and-test preview http://localhost:4173 'cypress run --e2e'",
    "test:e2e:dev": "start-server-and-test 'vite dev --port 4173' http://localhost:4173 'cypress open --e2e'",
    "lint": "eslint . --ext .vue,.js,.jsx,.cjs,.mjs --fix --ignore-path .gitignore",
    "format": "prettier --write src/"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@trevorism/ui-auth": "^1.2.0",
    "@trevorism/ui-header-bar": "^6.0.0",
    "vue": "^3.5.41",
    "vue-router": "^5.2.0",
    "vue3-click-away": "^1.2.4",
    "vuestic-ui": "^1.10.3"
  },
  "devDependencies": {
    "@rushstack/eslint-patch": "^1.16.1",
    "@trevorism/vitest-test-result-events": "^2.0.0",
    "@vitejs/plugin-vue": "^6.0.8",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/test-utils": "^2.4.11",
    "axios": "^1.19.0",
    "cypress": "^15.21.0",
    "eslint": "^10.9.0",
    "eslint-plugin-cypress": "^7.0.1",
    "jsdom": "^30.0.1",
    "prettier": "^3.9.6",
    "properties-reader": "^3.0.1",
    "start-server-and-test": "^3.0.12",
    "tailwindcss": "^4.3.3",
    "vite": "^8.2.2",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "vue-demi@0.14.10": true,
    "cypress@15.21.0": true
  }
}
